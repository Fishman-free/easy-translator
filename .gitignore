# 开发过程中的临时探针与调试脚本，不随扩展发布
_probe/

# 依赖与构建产物
node_modules/
*.tgz
dist/

# 商店打包产物（可由 npm run build:store 随时再生，不进版本库）
store/*.zip

# Python（desktop/ 桌面伴生）
__pycache__/
*.py[cod]
desktop/.venv/

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# 桌面伴生排障转储（desktop/ocr_dump.on 开关存在时才生成）
desktop/ocr_dump/
desktop/ocr_dump.on

# 游戏标记：游戏守护写入，取词守护读到就整条链停工（不该提交）
desktop/gaming.flag
